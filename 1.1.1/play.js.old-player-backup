                    !hasNativeMHPlayer()
                ) {
                    return;
                }

                try {

                    const state =
                        await getMHPlayer().getState();

                    if (
                        !state?.available ||
                        !Number.isFinite(state.duration) ||
                        state.duration <= 0
                    ) {
                        return;
                    }

                    clearInterval(
                        nativePlayerRestoreTimer
                    );

                    nativePlayerRestoreTimer =
                        null;

                    if (duration) {
                        duration.textContent =
                            formatTime(state.duration);
                    }

                    await restorePlaybackProgress();

                    if (
                        playbackRestoreDone &&
                        getPlaybackProgress() <= 0
                    ) {

                        if (currentTime) {
                            currentTime.textContent =
                                "0:00";
                        }

                        if (seekBar) {
                            seekBar.value =
                                0;
                        }

                    }

                    if (videoLoadTimer) {
                        clearTimeout(videoLoadTimer);
                        videoLoadTimer = null;
                    }

                    hideOverlay(
                        loadingOverlay
                    );

                    console.log(
                        "MH Movies: native player ready.",
                        "Duration:",
                        state.duration
                    );

                } catch (error) {

                    console.error(
                        "MH Movies: native player restore check failed:",
                        error
                    );

                }

            },
            500
        );

}

startNativePlayerRestoreCheck();


/* =========================================================
   VIDEO ENDED
========================================================= */

let nativePlayerWasNearEnd = false;

setInterval(
    async () => {

        if (
            isEmbedSource ||
            !hasNativeMHPlayer()
        ) {
            return;
        }

        try {

            const state =
                await getMHPlayer().getState();

            if (
                !state?.available ||
                !Number.isFinite(state.duration) ||
                state.duration <= 0
            ) {
                return;
            }

            const position =
                Number(state.position) || 0;

            const nearEnd =
                position >=
                state.duration - 1;

            if (
                nearEnd &&
                !nativePlayerWasNearEnd
            ) {

                nativePlayerWasNearEnd =
                    true;

                stopPlaybackSaveTimer();

                clearPlaybackProgress();

                if (seekBar) {
                    seekBar.value = 100;
                }

                if (currentTime) {
                    currentTime.textContent =
                        formatTime(state.duration);
                }

                if (playPauseButton) {
                    playPauseButton.textContent =
                        "▶";
                }

                console.log(
                    "MH Movies: movie finished. Saved progress cleared."
                );

            }

            if (!nearEnd) {
                nativePlayerWasNearEnd = false;
            }

        } catch (error) {

            console.error(
                "MH Movies: native ended-state check failed:",
                error
            );

        }

    },
    500
);


/* =========================================================
   SEEK
========================================================= */

if (seekBar) {

    seekBar.addEventListener(
        "input",
        async () => {

            if (isEmbedSource || !hasNativeMHPlayer()) {
                return;
            }

            const mhPlayer = getMHPlayer();

            try {
                const state = await mhPlayer.getState();

                if (
                    !state?.available ||
                    !Number.isFinite(state.duration) ||
                    state.duration <= 0
                ) {
                    return;
                }

                const percentage =
                    Number(seekBar.value);

                const targetTime =
                    (percentage / 100) *
                    state.duration;

                await mhPlayer.seekTo({
                    position: targetTime
                });

                savePlaybackProgress();

            } catch (error) {
                console.error(
                    "MH Movies: native seek bar failed:",
                    error
                );
            }
        }
    );

}


