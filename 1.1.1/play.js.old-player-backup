   TIME
========================================================= */

if (hasNativeMHPlayer()) {

    setInterval(
        async () => {

            if (isEmbedSource) {
                return;
            }

            try {

                const state =
                    await getMHPlayer().getState();

                if (
                    !state?.available ||
                    !Number.isFinite(state.duration) ||
                    state.duration <= 0
                ) {
                    return;
                }

                const position =
                    Number(state.position) || 0;

                const percent =
                    (
                        position /
                        state.duration
                    ) * 100;

                if (seekBar) {
                    seekBar.value =
                        Math.max(
                            0,
                            Math.min(
                                100,
                                percent
                            )
                        );
                }

                if (currentTime) {
                    currentTime.textContent =
                        formatTime(position);
                }

                if (duration) {
                    duration.textContent =
                        formatTime(state.duration);
                }

                updateSubtitleDisplay();

            } catch (error) {

                console.error(
                    "MH Movies: native time update failed:",
                    error
                );

            }

        },
        500
    );

}


