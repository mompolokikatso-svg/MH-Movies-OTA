async function lockToCurrentLandscape() {

        const ScreenOrientation =
            window.Capacitor?.Plugins?.ScreenOrientation;

        const MHFullscreen =
            window.Capacitor?.Plugins?.MHFullscreen;
        window.Capacitor?.Plugins?.ScreenOrientation;


    if (!ScreenOrientation) {

        return;

    }


    const currentType =
        screen.orientation?.type ||
        "";


    const targetOrientation =
        currentType.startsWith(
            "landscape"
        )
            ? currentType
            : "landscape-primary";


    try {

        await ScreenOrientation.lock({
            orientation:
                targetOrientation
        });

    } catch (error) {

        console.error(
            "Unable to lock orientation:",
            error
        );

    }

}


async function toggleFullscreen() {

    try {

        const MHFullscreen =
            window.Capacitor?.Plugins?.MHFullscreen;


        if (document.fullscreenElement) {

            await document.exitFullscreen();

            if (MHFullscreen) {
                await MHFullscreen.exit();
            }

        } else {

            if (!videoContainer) {
                return;
            }

            if (MHFullscreen) {
                await MHFullscreen.enter();
            }

            await videoContainer.requestFullscreen();

        }

    } catch (error) {

        console.error(
            "Fullscreen / rotation failed:",
            error
        );

    }

}


