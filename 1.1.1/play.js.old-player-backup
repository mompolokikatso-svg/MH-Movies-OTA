/* =========================================================
   CHECK EMBED URL
========================================================= */

function isEmbedUrl(
    url
) {

    if (!url) {

        return false;

    }


    const value =
        String(url)
            .toLowerCase();


    return (
        value.includes(
            "/embed/"
        ) ||
        value.includes(
            "embed."
        ) ||
        value.includes(
            "/iframe/"
        )
    );

}


