let nativePlayerStateTimer = null;
let nativePlayerWasPlaying = false;

function startNativePlayerStateTimer() {

    if (nativePlayerStateTimer) {
        clearInterval(nativePlayerStateTimer);
    }

    nativePlayerStateTimer = setInterval(
        async () => {

            if (
                isEmbedSource ||
                !hasNativeMHPlayer()
            ) {
                return;
            }

            try {

                const state =
                    await getMHPlayer().getState();

                if (!state?.available) {
                    return;
                }

                const playing =
                    !!state.playing;

                if (playPauseButton) {
                    playPauseButton.textContent =
                        playing ? "⏸" : "▶";
                }

                if (
                    playing &&
                    !nativePlayerWasPlaying
                ) {
                    startPlaybackSaveTimer();
                }

                if (
                    !playing &&
                    nativePlayerWasPlaying
                ) {
                    await savePlaybackProgress();
                    stopPlaybackSaveTimer();
                }

                nativePlayerWasPlaying =
                    playing;

            } catch (error) {

                console.error(
                    "MH Movies: native player state update failed:",
                    error
                );

            }

        },
        500
    );

}

function stopNativePlayerStateTimer() {

    if (nativePlayerStateTimer) {

        clearInterval(
            nativePlayerStateTimer
        );

        nativePlayerStateTimer = null;

    }

}

startNativePlayerStateTimer();


