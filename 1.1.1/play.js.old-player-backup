                if (state.volume > 0) {

                    window.mhMoviesLastVolume =
                        state.volume;

                    await mhPlayer.setVolume({
                        volume: 0
                    });

                    muteButton.textContent = "🔇";

                } else {

                    const volume =
                        Number(window.mhMoviesLastVolume) || 1;

                    await mhPlayer.setVolume({
                        volume
                    });

                    muteButton.textContent = "🔊";
                }

            } catch (error) {
                console.error(
                    "MH Movies: native mute failed:",
                    error
                );
            }
        }
    );

}


/* =========================================================
   10 SECOND SKIP CONTROLS
========================================================= */

async function seekBySeconds(seconds) {

    if (isEmbedSource || !hasNativeMHPlayer()) {
        return;
    }

    const mhPlayer = getMHPlayer();

    try {
        const state = await mhPlayer.getState();

        if (
            !state?.available ||
            !Number.isFinite(state.duration)
        ) {
            return;
        }

        const currentTime =
            Number(state.position) || 0;

        const targetTime =
            Math.max(
                0,
                Math.min(
                    state.duration,
                    currentTime + seconds
                )
            );

        await mhPlayer.seekTo({
            position: targetTime
        });

        updateSubtitleDisplay();

    } catch (error) {
        console.error("MH Movies: native seek failed:", error);
    }
}


